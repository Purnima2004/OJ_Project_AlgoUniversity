# AWS Production Dockerfile for FullMoon OJ
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=oj_backend.settings_aws

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    default-jdk \
    default-jre \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy project
COPY . .

# Create necessary directories
RUN mkdir -p /app/codes
RUN mkdir -p /app/staticfiles
RUN mkdir -p /app/media
RUN mkdir -p /var/log/fullmoon_oj

# Collect static files
RUN python manage.py collectstatic --noinput --settings=oj_backend.settings_aws

# Create non-root user
RUN useradd -m -u 1000 ojuser && chown -R ojuser:ojuser /app /var/log/fullmoon_oj
USER ojuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Run with Gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-", "oj_backend.wsgi:application"]
